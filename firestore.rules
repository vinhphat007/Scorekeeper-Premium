rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      // Anyone with the room code can read live scores (guests are read-only).
      allow read: if true;
      // Any signed-in (anonymous) client can create a new room.
      allow create: if request.auth != null;
      // Only the device that created the room (matching hostUid) can update it.
      allow update: if request.auth != null && request.auth.uid == resource.data.hostUid;
      // Only the host can close (delete) their own room — this is what kicks
      // any connected guests back to the welcome screen.
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostUid;
    }
  }
}

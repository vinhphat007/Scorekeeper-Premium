{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "main": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['revision', 'state']) && newData.child('revision').isNumber() && newData.child('state').hasChildren(['players', 'currentScreen', 'scoreMode'])"
      }
    }
  }
}
